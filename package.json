{
  "name": "nobistudio-static-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:format && npm run lint:css",
    "lint:js": "eslint public/assets/js scripts tests",
    "lint:format": "prettier --check package.json *.config.js public/assets/js/src scripts tests .github/workflows",
    "lint:css": "stylelint \"public/assets/css/**/*.css\"",
    "validate:html": "html-validate \"public/**/*.html\"",
    "validate:links": "node scripts/validate-links.mjs",
    "validate": "npm run validate:html && npm run validate:links",
    "test": "vitest run",
    "build": "node scripts/run-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort --outDir dist",
    "smoke": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "html-validate": "11.16.0",
    "prettier": "3.9.8",
    "stylelint": "17.15.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
