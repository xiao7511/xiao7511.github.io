{
  "name": "nobi-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src vite.config.ts capacitor.config.ts",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync",
    "cap:sync:android": "npm run build && cap sync android",
    "android": "npm run cap:sync:android && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@supabase/supabase-js": "^2.57.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.5.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.1.0"
  }
}
